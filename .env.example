ENV_ENVIRONMENT=production
# development defaults to http://localhost:3000/tunnel; production defaults to https://tunnexo.live/tunnel.
# Optional advanced overrides; normal guest usage needs no .env.
# TUNNEXO_SERVER_URL=https://tunnexo.live/tunnel
# TUNNEXO_AGENT_NAME_PREFIX=tunnexo
# A nonempty explicit token skips automatic guest registration.
# TUNNEXO_AGENT_TOKEN=
